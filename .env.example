# Copy to .env (gitignored) or export in your shell / CI secret store.
# NEVER commit real keys. Leave values empty here.

# --- Claude (Anthropic) ---
ANTHROPIC_API_KEY=
AISSEC_CLAUDE_MODEL=

# --- Hermes via an OpenAI-compatible API (OpenRouter / Together / Fireworks / vLLM / Ollama) ---
OPENAI_API_KEY=
OPENROUTER_API_KEY=
OPENAI_BASE_URL=
AISSEC_HERMES_MODEL=

# --- Local Hermes (Ollama) target "hermes-local" ---
AISSEC_LOCAL_API_KEY=
AISSEC_LOCAL_BASE_URL=

# --- "custom" target ---
AISSEC_CUSTOM_API_KEY=
AISSEC_CUSTOM_BASE_URL=
AISSEC_CUSTOM_MODEL=

# --- Optional LLM judge (aisec run --judge) ---
AISSEC_JUDGE_MODEL=
AISSEC_JUDGE_BASE_URL=
AISSEC_JUDGE_API_KEY=
